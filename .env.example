# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
# Optional: password-protect the API + UI. Leave unset for local single-user use.
# Required when NODE_ENV=production.
APP_PASSWORD=

# SQLite location (defaults to ./data/auto_apply.db)
# DB_PATH=/data/auto_apply.db

# Resume upload directory (defaults to ./uploads)
# UPLOADS_DIR=/data/uploads

# ── Apply scripts ───────────────────────────────────────────────────────────
# Base URL of this server, used by scout + apply scripts
# JOBS_API=http://localhost:3001

# Chrome DevTools Protocol port. Launch Chrome with:
#   /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome \
#     --remote-debugging-port=9222 --user-data-dir="$HOME/.chrome-debug-profile"
# CDP_PORT=9222

# Where appliers save screenshots (defaults to ./screenshots)
# SHOT_DIR=./screenshots

# Greenhouse email-verification code drop file (see README)
# GH_CODE_FILE=/tmp/gh_seccode.txt
